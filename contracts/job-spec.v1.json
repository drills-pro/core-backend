{
  "$defs": {
    "DataKind": {
      "enum": [
        "images",
        "tabular",
        "text"
      ],
      "title": "DataKind",
      "type": "string"
    },
    "DatasetLimits": {
      "additionalProperties": false,
      "description": "Ceilings the API and the ingest job enforce (docs/datasets-plan.md decision 16). Static knobs.",
      "properties": {
        "csv_max_columns": {
          "title": "Csv Max Columns",
          "type": "integer"
        },
        "csv_max_rows": {
          "title": "Csv Max Rows",
          "type": "integer"
        },
        "csv_min_rows": {
          "title": "Csv Min Rows",
          "type": "integer"
        },
        "extracted_max_bytes": {
          "title": "Extracted Max Bytes",
          "type": "integer"
        },
        "extracted_max_ratio": {
          "title": "Extracted Max Ratio",
          "type": "integer"
        },
        "hf_max_repo_bytes": {
          "title": "Hf Max Repo Bytes",
          "type": "integer"
        },
        "image_max_bytes": {
          "title": "Image Max Bytes",
          "type": "integer"
        },
        "image_max_dimension": {
          "title": "Image Max Dimension",
          "type": "integer"
        },
        "job_timeout_seconds": {
          "title": "Job Timeout Seconds",
          "type": "integer"
        },
        "max_active_imports_per_tenant": {
          "title": "Max Active Imports Per Tenant",
          "type": "integer"
        },
        "max_archive_depth": {
          "title": "Max Archive Depth",
          "type": "integer"
        },
        "max_files": {
          "title": "Max Files",
          "type": "integer"
        },
        "max_path_length": {
          "title": "Max Path Length",
          "type": "integer"
        },
        "ray_job_cpus": {
          "title": "Ray Job Cpus",
          "type": "integer"
        },
        "ray_job_memory_bytes": {
          "title": "Ray Job Memory Bytes",
          "type": "integer"
        },
        "upload_max_bytes": {
          "title": "Upload Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "upload_max_bytes",
        "extracted_max_bytes",
        "extracted_max_ratio",
        "max_files",
        "max_archive_depth",
        "max_path_length",
        "image_max_dimension",
        "image_max_bytes",
        "csv_min_rows",
        "csv_max_rows",
        "csv_max_columns",
        "hf_max_repo_bytes",
        "job_timeout_seconds",
        "ray_job_cpus",
        "ray_job_memory_bytes",
        "max_active_imports_per_tenant"
      ],
      "title": "DatasetLimits",
      "type": "object"
    },
    "Hyperparameters": {
      "description": "What a caller may tune; every field has the platform default, so a request names only what it changes.",
      "properties": {
        "batch_size": {
          "default": 16,
          "maximum": 512,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "epochs": {
          "default": 30,
          "maximum": 500,
          "minimum": 1,
          "title": "Epochs",
          "type": "integer"
        },
        "image_size": {
          "default": 224,
          "maximum": 1536,
          "minimum": 32,
          "title": "Image Size",
          "type": "integer"
        }
      },
      "title": "Hyperparameters",
      "type": "object"
    },
    "ImportSource": {
      "description": "Where a dataset import's data comes from. Mirrors the dataset_imports_source_check constraint.",
      "enum": [
        "upload",
        "huggingface"
      ],
      "title": "ImportSource",
      "type": "string"
    },
    "IngestBase": {
      "description": "Presigned reads of the base version a merge import builds on: index (images) or data + schema (tabular).",
      "properties": {
        "data_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Url"
        },
        "index_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Url"
        },
        "schema_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Url"
        }
      },
      "title": "IngestBase",
      "type": "object"
    },
    "IngestHf": {
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "revision"
      ],
      "title": "IngestHf",
      "type": "object"
    },
    "IngestPayload": {
      "description": "What the ingest entrypoints read (ray_jobs.common.enums.Param mirrors these keys; contract-tested).",
      "properties": {
        "base": {
          "anyOf": [
            {
              "$ref": "#/$defs/IngestBase"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bucket": {
          "title": "Bucket",
          "type": "string"
        },
        "hf": {
          "anyOf": [
            {
              "$ref": "#/$defs/IngestHf"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limits": {
          "$ref": "#/$defs/DatasetLimits"
        },
        "prefix": {
          "title": "Prefix",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ImportSource"
        },
        "split": {
          "anyOf": [
            {
              "$ref": "#/$defs/Split"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "task": {
          "$ref": "#/$defs/TaskType"
        }
      },
      "required": [
        "bucket",
        "prefix",
        "source",
        "task",
        "limits"
      ],
      "title": "IngestPayload",
      "type": "object"
    },
    "IngestSpec": {
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "const": "ingest",
          "default": "ingest",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/IngestPayload"
        },
        "resources": {
          "$ref": "#/$defs/Resources"
        },
        "spec_version": {
          "const": 1,
          "default": 1,
          "title": "Spec Version",
          "type": "integer"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "tenant_id",
        "resources",
        "payload"
      ],
      "title": "IngestSpec",
      "type": "object"
    },
    "Preprocessing": {
      "description": "How an image becomes the model's input: resize (stretch, to a square `image_size`) with `resample`, multiply by\n`rescale`, then (x - mean) / std per RGB channel. Trained with, recorded in model.json, applied again when serving.",
      "properties": {
        "mean": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Mean",
          "type": "array"
        },
        "resample": {
          "$ref": "#/$defs/Resample"
        },
        "rescale": {
          "exclusiveMinimum": 0,
          "title": "Rescale",
          "type": "number"
        },
        "std": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Std",
          "type": "array"
        }
      },
      "required": [
        "mean",
        "std",
        "rescale",
        "resample"
      ],
      "title": "Preprocessing",
      "type": "object"
    },
    "Resample": {
      "description": "PIL resampling filter of the resize to a square `image_size` (the trainer mirrors this enum, contract-tested).",
      "enum": [
        "bilinear",
        "bicubic"
      ],
      "title": "Resample",
      "type": "string"
    },
    "Resources": {
      "description": "Declared, never inferred (planning 06): the scheduler and quotas act on these.",
      "properties": {
        "cpu": {
          "exclusiveMinimum": 0,
          "title": "Cpu",
          "type": "number"
        },
        "gpu": {
          "default": 0,
          "minimum": 0,
          "title": "Gpu",
          "type": "number"
        },
        "max_runtime_s": {
          "default": 0,
          "minimum": 0,
          "title": "Max Runtime S",
          "type": "integer"
        },
        "memory_bytes": {
          "exclusiveMinimum": 0,
          "title": "Memory Bytes",
          "type": "integer"
        }
      },
      "required": [
        "cpu",
        "memory_bytes"
      ],
      "title": "Resources",
      "type": "object"
    },
    "Split": {
      "description": "Values of the nullable `split` column. Datasets never invent one (plan decision 9).",
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "TaskType": {
      "description": "Hugging Face task slugs, verbatim. Mirrors the projects.task_type CHECK constraint. The whole\ntaxonomy is accepted by the schema; the task_types table is what the platform can do today.",
      "enum": [
        "image-classification",
        "object-detection",
        "image-segmentation",
        "tabular-classification",
        "tabular-regression",
        "text-classification",
        "token-classification",
        "question-answering",
        "summarization",
        "translation",
        "text-generation",
        "audio-classification",
        "automatic-speech-recognition",
        "text-to-speech"
      ],
      "title": "TaskType",
      "type": "string"
    },
    "TextPreprocessing": {
      "additionalProperties": false,
      "description": "How text becomes the model's input: the base model's tokenizer, truncated and padded to `max_length` tokens.\nTrained with, recorded in model.json (with tokenizer.json), applied again when serving.",
      "properties": {
        "max_length": {
          "exclusiveMinimum": 0,
          "title": "Max Length",
          "type": "integer"
        }
      },
      "required": [
        "max_length"
      ],
      "title": "TextPreprocessing",
      "type": "object"
    },
    "TrainBaseModel": {
      "description": "A pretrained checkpoint on the Hugging Face Hub, pinned to a commit.",
      "properties": {
        "repo_id": {
          "title": "Repo Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "revision"
      ],
      "title": "TrainBaseModel",
      "type": "object"
    },
    "TrainData": {
      "description": "Presigned reads of one dataset version, valid past `resources.max_runtime_s`. The trainer holds no lakeFS credential.",
      "properties": {
        "data_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Url"
        },
        "index_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Url"
        },
        "lakefs_commit": {
          "title": "Lakefs Commit",
          "type": "string"
        },
        "manifest_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Url"
        },
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "lakefs_commit"
      ],
      "title": "TrainData",
      "type": "object"
    },
    "TrainPayload": {
      "description": "What the train driver reads. It writes `model.onnx`, `model.json` and `report.json` under `prefix` in `bucket`.",
      "properties": {
        "base_model": {
          "$ref": "#/$defs/TrainBaseModel"
        },
        "bucket": {
          "title": "Bucket",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TrainData"
        },
        "data_kind": {
          "$ref": "#/$defs/DataKind"
        },
        "hyperparameters": {
          "$ref": "#/$defs/Hyperparameters"
        },
        "learning_rate": {
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "prefix": {
          "title": "Prefix",
          "type": "string"
        },
        "preprocessing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Preprocessing"
            },
            {
              "$ref": "#/$defs/TextPreprocessing"
            }
          ],
          "title": "Preprocessing"
        },
        "preset": {
          "title": "Preset",
          "type": "string"
        },
        "seed": {
          "default": 42,
          "title": "Seed",
          "type": "integer"
        },
        "task": {
          "$ref": "#/$defs/TaskType"
        },
        "trainer": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Trainer",
          "type": "string"
        }
      },
      "required": [
        "bucket",
        "prefix",
        "task",
        "trainer",
        "data_kind",
        "preset",
        "base_model",
        "learning_rate",
        "preprocessing",
        "data",
        "hyperparameters"
      ],
      "title": "TrainPayload",
      "type": "object"
    },
    "TrainSpec": {
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "const": "train",
          "default": "train",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/TrainPayload"
        },
        "resources": {
          "$ref": "#/$defs/Resources"
        },
        "spec_version": {
          "const": 1,
          "default": 1,
          "title": "Spec Version",
          "type": "integer"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "tenant_id",
        "resources",
        "payload"
      ],
      "title": "TrainSpec",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "ingest": "#/$defs/IngestSpec",
      "train": "#/$defs/TrainSpec"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/IngestSpec"
    },
    {
      "$ref": "#/$defs/TrainSpec"
    }
  ]
}
