#!/bin/sh
# Lints the staged Python files with ruff (config: ruff.toml). Enable once per clone: ./scripts/install-hooks.sh
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
[ -z "$files" ] && exit 0
ruff="$(git rev-parse --show-toplevel)/core-api/.venv/bin/ruff"
[ -x "$ruff" ] || { echo "pre-commit: ruff not found, run 'uv sync --group dev' in core-api" >&2; exit 1; }
# shellcheck disable=SC2086
"$ruff" check $files
