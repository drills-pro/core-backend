{
  "schema": 1,
  "slug": "text-classification",
  "display_name": "Text classification",
  "data_kind": "text",
  "contract": 1,
  "trainer": "textcls.train:train",
  "smoke": "textcls.smoke:spec_doc",
  "serving": {
    "encoder": "text_encoder",
    "postprocess": "classify"
  },
  "servable": true,
  "monitor": "top1",
  "hyperparameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "epochs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 30,
        "description": "Passes over the training split."
      },
      "batch_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 512,
        "default": 16,
        "description": "Samples per optimizer step, per worker."
      },
      "image_size": {
        "type": "integer",
        "minimum": 32,
        "maximum": 1536,
        "default": 224,
        "description": "Side of the square the images are resized to (image tasks)."
      },
      "weight_decay": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.01,
        "description": "AdamW weight decay: pulls weights toward zero against overfitting."
      }
    }
  },
  "presets": [
    {
      "name": "small",
      "base_model": {
        "repo_id": "distilbert/distilbert-base-uncased",
        "revision": "12040accade4e8a0f71eabdb258fecc2e7e948be"
      },
      "learning_rate": 2e-05,
      "preprocessing": {
        "max_length": 256
      },
      "cpu": 8,
      "memory_bytes": 25769803776,
      "gpu": 1,
      "max_runtime_s": 14400,
      "lr_schedule": "constant",
      "warmup_fraction": 0,
      "augmentation": "none",
      "early_stopping_patience": 3,
      "hyperparameters": {
        "epochs": 30,
        "batch_size": 16,
        "image_size": 224
      },
      "display_name": "Quick",
      "description": "Fastest to train. A good first try for a short or simple text dataset."
    },
    {
      "name": "medium",
      "base_model": {
        "repo_id": "google-bert/bert-base-uncased",
        "revision": "86b5e0934494bd15c9632b12f734a8a67f723594"
      },
      "learning_rate": 2e-05,
      "preprocessing": {
        "max_length": 256
      },
      "cpu": 8,
      "memory_bytes": 25769803776,
      "gpu": 1,
      "max_runtime_s": 14400,
      "lr_schedule": "constant",
      "warmup_fraction": 0,
      "augmentation": "none",
      "early_stopping_patience": 3,
      "hyperparameters": {
        "epochs": 30,
        "batch_size": 16,
        "image_size": 224
      },
      "display_name": "Balanced",
      "description": "A good mix of speed and accuracy for most text datasets."
    },
    {
      "name": "large",
      "base_model": {
        "repo_id": "answerdotai/ModernBERT-base",
        "revision": "8949b909ec900327062f0ebf497f51aef5e6f0c8"
      },
      "learning_rate": 1e-05,
      "preprocessing": {
        "max_length": 256
      },
      "cpu": 8,
      "memory_bytes": 25769803776,
      "gpu": 1,
      "max_runtime_s": 14400,
      "lr_schedule": "constant",
      "warmup_fraction": 0,
      "augmentation": "none",
      "early_stopping_patience": 3,
      "hyperparameters": {
        "epochs": 30,
        "batch_size": 16,
        "image_size": 224
      },
      "display_name": "Most accurate",
      "description": "Takes the longest to train and is usually the most accurate. Use it when accuracy matters most."
    }
  ],
  "requires": [
    "torch",
    "transformers",
    "tokenizers",
    "numpy",
    "pyarrow",
    "onnx"
  ],
  "requirements": [
    "annotated-doc==0.0.6",
    "annotated-types==0.8.0",
    "anyio==4.16.0",
    "click==8.5.1",
    "h11==0.16.0",
    "hf-xet==1.8.0",
    "httpcore2==2.16.0",
    "httpx2==2.16.0",
    "huggingface-hub==2.4.0",
    "idna==3.20",
    "markdown-it-py==4.3.0",
    "mdurl==0.1.2",
    "pydantic==2.14.3",
    "pydantic-core==2.50.4",
    "pygments==2.21.0",
    "pyyaml==6.0.3",
    "regex==2026.11.9",
    "rich==15.0.0",
    "safetensors==0.8.0",
    "shellingham==1.5.4",
    "tokenizers==0.23.3",
    "tqdm==4.70.1",
    "transformers==5.23.0",
    "truststore==0.10.5",
    "typer==0.29.1",
    "typing-inspection==0.4.5"
  ]
}
