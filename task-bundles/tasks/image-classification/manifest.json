{
  "schema": 1,
  "slug": "image-classification",
  "display_name": "Image classification",
  "data_kind": "images",
  "contract": 1,
  "trainer": "imgcls.train:train",
  "smoke": "imgcls.smoke:spec_doc",
  "serving": {
    "encoder": "image_encoder",
    "postprocess": "classify"
  },
  "servable": true,
  "monitor": "top1",
  "hyperparameters": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "epochs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 30,
        "description": "Passes over the training split."
      },
      "batch_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 512,
        "default": 16,
        "description": "Samples per optimizer step, per worker."
      },
      "image_size": {
        "type": "integer",
        "minimum": 32,
        "maximum": 1536,
        "default": 224,
        "description": "Side of the square the images are resized to (image tasks)."
      },
      "weight_decay": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.01,
        "description": "AdamW weight decay: pulls weights toward zero against overfitting."
      }
    }
  },
  "presets": [
    {
      "name": "small",
      "base_model": {
        "repo_id": "facebook/convnextv2-tiny-1k-224",
        "revision": "f4db009e63145e02b3c075aa64d90ce41bcca4b1"
      },
      "learning_rate": 0.0001,
      "preprocessing": {
        "mean": [
          0.485,
          0.456,
          0.406
        ],
        "std": [
          0.229,
          0.224,
          0.225
        ],
        "rescale": 0.00392156862745098,
        "resample": "bicubic"
      },
      "cpu": 8,
      "memory_bytes": 25769803776,
      "gpu": 1,
      "max_runtime_s": 14400,
      "lr_schedule": "constant",
      "warmup_fraction": 0,
      "augmentation": "none",
      "early_stopping_patience": 3,
      "hyperparameters": {
        "epochs": 30,
        "batch_size": 16,
        "image_size": 224
      },
      "display_name": "Quick",
      "description": "Fastest to train. A good first try for a small or simple dataset."
    },
    {
      "name": "medium",
      "base_model": {
        "repo_id": "facebook/convnextv2-base-1k-224",
        "revision": "90fcd1da94cc5ffabf88b0f8aee31b0893b94501"
      },
      "learning_rate": 0.0001,
      "preprocessing": {
        "mean": [
          0.485,
          0.456,
          0.406
        ],
        "std": [
          0.229,
          0.224,
          0.225
        ],
        "rescale": 0.00392156862745098,
        "resample": "bicubic"
      },
      "cpu": 8,
      "memory_bytes": 25769803776,
      "gpu": 1,
      "max_runtime_s": 14400,
      "lr_schedule": "constant",
      "warmup_fraction": 0,
      "augmentation": "none",
      "early_stopping_patience": 3,
      "hyperparameters": {
        "epochs": 30,
        "batch_size": 16,
        "image_size": 224
      },
      "display_name": "Balanced",
      "description": "A good mix of speed and accuracy for most datasets."
    },
    {
      "name": "large",
      "base_model": {
        "repo_id": "microsoft/swin-base-patch4-window7-224",
        "revision": "20d6c26ef6455d36c0a78671d787c5da57513d4b"
      },
      "learning_rate": 5e-05,
      "preprocessing": {
        "mean": [
          0.485,
          0.456,
          0.406
        ],
        "std": [
          0.229,
          0.224,
          0.225
        ],
        "rescale": 0.00392156862745098,
        "resample": "bicubic"
      },
      "cpu": 8,
      "memory_bytes": 25769803776,
      "gpu": 1,
      "max_runtime_s": 14400,
      "lr_schedule": "constant",
      "warmup_fraction": 0,
      "augmentation": "none",
      "early_stopping_patience": 3,
      "hyperparameters": {
        "epochs": 30,
        "batch_size": 16,
        "image_size": 224
      },
      "display_name": "Most accurate",
      "description": "Takes the longest to train and is usually the most accurate. Use it when accuracy matters most."
    }
  ],
  "requires": [
